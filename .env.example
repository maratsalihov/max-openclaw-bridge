# Required: MAX API token from https://dev.max.ru
MAX_TOKEN=your_max_api_token_here

# Required: Comma-separated MAX user IDs allowed to use the bridge
ALLOWED_USER_IDS=16392982

# Optional: OpenClaw gateway settings (defaults shown below)
OC_GATEWAY_HOST=127.0.0.1
OC_GATEWAY_PORT=18789

# Optional: Bridge webhook server port
BRIDGE_PORT=8789

# Optional: OpenClaw gateway token (auto-detected from ~/.openclaw/openclaw.json if not set)
# OC_TOKEN=your_openclaw_token_here
